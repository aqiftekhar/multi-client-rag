OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b-it-qat 

# ChromaDB (overridden in docker-compose)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Embedding model (local, no API key needed)
EMBED_MODEL=all-MiniLM-L6-v2

# RAG tuning
MAX_CONTEXT_TOKENS=2000
COARSE_K=20
FINE_K=5

# Evaluation thresholds (CI/CD pass criteria)
DRIFT_THRESHOLD=0.15
EVAL_RECALL_MIN=0.5
EVAL_NDCG_MIN=0.6

# App
LOG_LEVEL=INFO

# Auth (leave empty in development, set keys in production)
API_KEYS=

# Semantic cache settings (optional overrides)
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_HOURS=24
CACHE_MAX_SIZE=500